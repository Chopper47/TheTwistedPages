  m_Script: {fileID: 11500000, guid: 100c93b88da0caa45adf477360673904, type: 3}
  m_Name: WolfEncounter1
  m_EditorClassIdentifier: 
  lines:
  - Hmm... Who do we have here?
  - Good day, Little girl. Where are you going so early?
  - Hmm... you seem quite...lost. Have I seen you before?
  - You remind me of a certain someone... Anyhow do you know how to navigate these
    woods?
  - Well, today you have caught me in a great mood, and, as the Generous and Kind
    gentleman I am, I shall teach you the way.
  characterName: Big Bad Wolf
  textDelay: 0.05
