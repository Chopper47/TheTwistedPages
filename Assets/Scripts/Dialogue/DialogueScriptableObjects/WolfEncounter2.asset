  m_Script: {fileID: 11500000, guid: 100c93b88da0caa45adf477360673904, type: 3}
  m_Name: WolfEncounter2
  m_EditorClassIdentifier: 
  lines:
  - See that? That's just one of the beasts that live in this forest, one of my brethen,
    even. Altough I find their class rather... undignified
  - A harmless one like you would never be able to defeat a beast like that, of course.
  - However, use that tiny head of yours for a bit and you might realize that this
    dear forest of mine can be rather... deadly.
  characterName: Big Bad Wolf
  textDelay: 0.05
  dialogueBox: {fileID: 21300000, guid: 4f125a5314795764892c81cb3e1c5c02, type: 3}
